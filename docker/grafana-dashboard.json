{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (status) (rate(methodos_http_requests_total[$__rate_interval]))", "legendFormat": "{{status}}"}],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(methodos_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95"}],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "100 * sum(rate(methodos_llm_attempts_total{outcome=\"failed\"}[$__rate_interval])) / clamp_min(sum(rate(methodos_llm_attempts_total{outcome=~\"started|succeeded|failed\"}[$__rate_interval])), 0.000001)", "legendFormat": "failure rate"}],
      "title": "LLM failure rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "methodos_evolution_jobs{state=\"queued\"}", "legendFormat": "queued"},
        {"expr": "methodos_evolution_jobs{state=\"running\"}", "legendFormat": "running"},
        {"expr": "methodos_evolution_jobs{state=\"failed\"}", "legendFormat": "failed"}
      ],
      "title": "Evolution queue",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (reason) (rate(methodos_auth_failures_total[$__rate_interval]))", "legendFormat": "{{reason}}"}],
      "title": "Authentication failures",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["methodos", "operations"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Methodos service overview",
  "uid": "methodos-overview",
  "version": 1
}
