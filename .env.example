# methodos configuration
# Copy this file to .env and adjust as needed. docker compose picks up
# .env from the same directory automatically.

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# Backend selector. One of: sqlite (default, production), filesystem (dev).
PGRAPH_BACKEND=sqlite

# Data root. The SQLite database (methodos.db) lives at
# $PGRAPH_HOME/methodos.db when sqlite is selected.
PGRAPH_HOME=/data

# Optional sqlite-vec extension. Set to 1 to enable semantic matching
# (requires the [vec] extra to be installed).
PGRAPH_VEC=0
PGRAPH_VEC_DIM=1536

# ---------------------------------------------------------------------------
# Auth (optional)
# ---------------------------------------------------------------------------

# When set, all /v1/* and /metrics routes require either
#   Authorization: Bearer <key>
# or
#   X-API-Key: <key>
# Use a high-entropy key (>= 32 random bytes, base64- or hex-encoded).
# Leave unset for dev (no auth enforced).
# PGRAPH_API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting (optional, enabled by default)
# ---------------------------------------------------------------------------

# Set to 1 to disable rate limiting entirely.
# PGRAPH_RATE_LIMIT_DISABLED=0

# Max tokens per bucket (per process). Default: 60.
# PGRAPH_RATE_LIMIT_CAPACITY=60

# Token refill rate per second. Default: 1.0.
# PGRAPH_RATE_LIMIT_REFILL_PER_SECOND=1.0

# ---------------------------------------------------------------------------
# HTTP hardening
# ---------------------------------------------------------------------------

# Maximum HTTP request body size in bytes. Bodies larger than this are
# rejected with HTTP 413 before they reach Pydantic. Default: 1048576 (1 MiB).
# PGRAPH_MAX_BODY_BYTES=1048576

# Comma-separated list of allowed CORS origins. Empty/unset = CORS
# disabled (suitable for service-to-service traffic behind a proxy).
# Example: PGRAPH_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# PGRAPH_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# LLM provider keys (one required; litellm reads these)
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROK_API_KEY=
