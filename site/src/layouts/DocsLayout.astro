---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/sachncs/methodos";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f5f4ef" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — methodos`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={`https://sachncs.github.io${Astro.url.pathname}`} />
    <title>{title} — methodos</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="methodos home">
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>methodos</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href={`${base}docs/`}>Docs</a>
        <a href={`${base}docs/api/`}>API</a>
        <a href={`${base}docs/production/`}>Production</a>
      </nav>
      <a class="source-link" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <a class="brand" href={base}><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>methodos</a>
      <span>Procedural memory for agents that need to get better.</span>
      <a href={repo}>Source on GitHub <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f5f4ef; color: #171817; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  a { color: inherit; text-decoration: none; }
  ::selection { background: #c9f25f; }
  :focus-visible { outline: 3px solid #8fbf4f; outline-offset: 4px; }
  .skip-link { position: absolute; left: 16px; top: -60px; padding: 10px 14px; border-radius: 6px; background: #171817; color: #fff; z-index: 10; }
  .skip-link:focus { top: 16px; }
  .site-header { height: 80px; padding: 0 max(24px, calc((100vw - 1160px) / 2)); display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid #deddd5; font-size: 13px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 750; letter-spacing: -.04em; white-space: nowrap; }
  .mark { display: flex; align-items: end; gap: 3px; width: 21px; height: 21px; padding: 4px; background: #171817; border-radius: 7px; }
  .mark i { width: 5px; background: #c9f25f; border-radius: 5px; }
  .mark i:nth-child(1) { height: 6px; }.mark i:nth-child(2) { height: 11px; }.mark i:nth-child(3) { height: 15px; }
  nav { display: flex; gap: 24px; color: #5f6059; }
  nav a:hover, .source-link:hover, .site-footer a:hover { color: #657d16; }
  .source-link { color: #5f6059; white-space: nowrap; }
  .doc-shell { width: min(1160px, calc(100% - 48px)); margin: auto; padding: 82px 0 120px; }
  .doc-hero { max-width: 760px; padding-bottom: 58px; }
  .eyebrow { color: #657d16; font: 11px ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 18px 0; max-width: 800px; font-size: clamp(48px, 7vw, 88px); line-height: .92; letter-spacing: -.08em; font-weight: 600; }
  h1 span, h2 span { color: #73766e; }
  .lede { max-width: 680px; color: #5d5e57; font-size: 19px; line-height: 1.6; }
  .doc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #d7d6ce; }
  .doc-card { min-height: 210px; padding: 28px; background: #f5f4ef; border: 1px solid transparent; }
  .doc-card:hover { border-color: #9dbb52; }
  .doc-card b { color: #657d16; font: 12px ui-monospace, monospace; }
  .doc-card h2 { margin: 34px 0 10px; font-size: 24px; letter-spacing: -.04em; }
  .doc-card p { margin: 0; color: #65675f; line-height: 1.55; }
  .doc-card small { display: block; margin-top: 22px; color: #657d16; font: 12px ui-monospace, monospace; }
  .content-grid { display: grid; grid-template-columns: 210px minmax(0, 760px); gap: 80px; align-items: start; }
  .toc { position: sticky; top: 24px; display: grid; gap: 12px; color: #65675f; font-size: 13px; }
  .toc a:hover { color: #657d16; }
  article { min-width: 0; }
  article h2 { margin: 0 0 18px; padding-top: 18px; font-size: clamp(32px, 4vw, 52px); line-height: 1; letter-spacing: -.065em; }
  article h2:not(:first-child) { margin-top: 72px; border-top: 1px solid #d7d6ce; }
  article h3 { margin: 34px 0 10px; font-size: 22px; letter-spacing: -.035em; }
  article p, article li { color: #555850; font-size: 16px; line-height: 1.7; }
  article ul, article ol { padding-left: 22px; }
  article code { padding: 3px 5px; border-radius: 4px; background: #e9e8e1; font: 13px ui-monospace, monospace; color: #3f4f11; }
  article pre { overflow: auto; padding: 22px; border-radius: 10px; background: #171817; color: #e6e8dd; font: 13px/1.7 ui-monospace, monospace; }
  article pre code { padding: 0; background: transparent; color: inherit; }
  .note { margin: 24px 0; padding: 18px 20px; border-left: 3px solid #9dbb52; background: #ecebe5; color: #555850; line-height: 1.6; }
  .pill { display: inline-block; margin: 5px 5px 0 0; padding: 7px 10px; border: 1px solid #d1d2c9; border-radius: 99px; color: #555850; font: 12px ui-monospace, monospace; }
  .site-footer { width: min(1160px, calc(100% - 48px)); margin: auto; display: flex; align-items: center; gap: 24px; padding: 26px 0 34px; border-top: 1px solid #deddd5; color: #5f6059; font-size: 12px; }
  .site-footer span:nth-child(2) { margin-right: auto; }
  @media (max-width: 780px) { .site-header { height: 68px; padding-inline: 18px; }.site-header nav { display: none; }.doc-shell { width: calc(100% - 36px); padding: 58px 0 82px; }.doc-grid { grid-template-columns: 1fr; }.content-grid { grid-template-columns: 1fr; gap: 38px; }.toc { position: static; display: flex; flex-wrap: wrap; gap: 10px 18px; padding-bottom: 24px; border-bottom: 1px solid #d7d6ce; }.site-footer { width: calc(100% - 36px); flex-wrap: wrap; }.site-footer span:nth-child(2) { flex-basis: 100%; order: 3; } }
</style>
