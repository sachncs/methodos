plate-columns:repeat(4,1fr)}.signals span{padding:18px 0;color:#5d5e57;font:10px monospace;letter-spacing:.14em;text-align:center;border-right:1px solid #deddd5}.signals span:first-child{border-left:1px solid #deddd5}.section{padding:140px 0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:72px;background:#d7d6ce}.cards article{min-height:240px;padding:32px;background:#f5f4ef}.cards b{color:#5f7515;font:12px monospace}.cards h3{margin:36px 0 12px;font-size:24px}.cards p{color:#5f6059;line-height:1.5}.cards code{display:block;margin-top:26px;font:11px monospace;color:#575850}.dark{padding:140px 0;background:#131414;color:#f5f4ef}.two{display:grid;grid-template-columns:.85fr 1.15fr;gap:100px}.dark .lede{color:#aeb3a9}.dark h2 span{color:#aeb3a9}.modules{border-top:1px solid #3a3b37}.modules a{display:block;padding:22px 0;border-bottom:1px solid #3a3b37;font:14px monospace}.modules a:hover{color:#c9f25f;padding-left:10px}.modules small{float:right;color:#aeb3a9}.two pre{padding:28px;overflow:auto;border:1px solid #d7d6ce;border-radius:12px;background:#ecebe5;color:#30312e;font:13px/1.8 monospace}.two pre span{color:#4c650b}footer{display:flex;align-items:center;gap:28px;padding:26px 0 34px;border-top:1px solid #deddd5;color:#5f6059;font-size:12px}footer span:nth-child(2){margin-right:auto}@media(max-width:780px){header{height:68px}header nav{display:none}.wrap{width:calc(100% - 36px)}.hero,.two{grid-template-columns:1fr;gap:48px;padding:80px 0}.hero{min-height:auto}.visual{min-height:360px}.signals .wrap{grid-template-columns:repeat(2,1fr)}.section,.dark{padding:92px 0}.cards{grid-template-columns:1fr;margin-top:48px}.cards article{min-height:auto}.modules small{float:none;margin-left:12px}footer{flex-wrap:wrap}footer span:nth-child(2){flex-basis:100%;order:3}}
.dark .eyebrow{color:#aeb3a9}
</style>
